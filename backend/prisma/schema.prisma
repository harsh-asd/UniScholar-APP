// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserOTR {
  id              String           @id @default(uuid())
  otrId           String           @unique @db.VarChar(14)
  maskedKycId     String
  fullName        String
  dob             DateTime
  gender          String
  stStatus        Boolean
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       DocumentWallet[]
  applications    ScholarshipApplication[]
}

enum DocumentType {
  INCOME_CERT
  CASTE_CERT
  ACADEMIC_MARK_SHEET
}

model DocumentWallet {
  id            String       @id @default(uuid())
  otrId         String
  documentType  DocumentType
  digilockerUri String
  isVerified    Boolean      @default(true)
  fetchedAt     DateTime     @default(now())
  
  user          UserOTR      @relation(fields: [otrId], references: [otrId], onDelete: Cascade)

  @@unique([otrId, documentType])
}

enum ApplicationStatus {
  SUBMITTED
  L1_APPROVED
  L1_REJECTED
  L2_APPROVED
  L2_REJECTED
  SANCTIONED
  DISBURSED
}

model ScholarshipApplication {
  id            String            @id @default(uuid())
  otrId         String
  schemeName    String
  status        ApplicationStatus @default(SUBMITTED)
  l1Remarks     String?
  l2Remarks     String?
  appliedAt     DateTime          @default(now())
  
  user          UserOTR           @relation(fields: [otrId], references: [otrId], onDelete: Cascade)
}

enum AdminRole {
  L1_INSTITUTE
  L2_DISTRICT
  MOTA_ADMIN
}

model AdminUser {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  role                    AdminRole
  assignedInstitutionCode String?   // Nullable for MOTA_ADMIN
  createdAt               DateTime  @default(now())
}
