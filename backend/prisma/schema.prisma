// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model UserOTR {
  id              String           @id @default(uuid())
  otrId           String           @unique
  maskedKycId     String
  fullName        String
  dob             DateTime
  gender          String
  stStatus        Boolean
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       DocumentWallet[]
  applications    ScholarshipApplication[]
}

model DocumentWallet {
  id            String       @id @default(uuid())
  otrId         String
  documentType  String
  digilockerUri String
  isVerified    Boolean      @default(true)
  fetchedAt     DateTime     @default(now())
  
  user          UserOTR      @relation(fields: [otrId], references: [otrId], onDelete: Cascade)

  @@unique([otrId, documentType])
}

model ScholarshipApplication {
  id            String            @id @default(uuid())
  otrId         String
  schemeName    String
  status        String            @default("SUBMITTED")
  l1Remarks     String?
  l2Remarks     String?
  appliedAt     DateTime          @default(now())
  
  user          UserOTR           @relation(fields: [otrId], references: [otrId], onDelete: Cascade)
}

model AdminUser {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  role                    String
  assignedInstitutionCode String?   // Nullable for MOTA_ADMIN
  createdAt               DateTime  @default(now())
}
