// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserOTR {
  id           String   @id @default(uuid())
  otrId        String   @unique @db.VarChar(14)
  maskedKycId  String
  fullName     String
  dob          DateTime
  gender       String
  stStatus     Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
